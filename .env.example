# Setup guide for every value below (local + Vercel production): docs/secrets.md
# ─────────────────────────────────────────────────────────────────────────────
# Required: Database
# ─────────────────────────────────────────────────────────────────────────────
# Option A — Neon (managed). Grab both URLs from Dashboard → Connection Details.
# DATABASE_URL = pooled (PgBouncer) connection
# DIRECT_URL   = direct connection — used by `prisma db push` / migrate / seed
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/servicelens?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/servicelens?sslmode=require"
# Option B — local Postgres via `docker compose up -d postgres`:
# DATABASE_URL="postgresql://servicelens:servicelens@localhost:5432/servicelens?sslmode=disable"
# DIRECT_URL="postgresql://servicelens:servicelens@localhost:5432/servicelens?sslmode=disable"

# ─────────────────────────────────────────────────────────────────────────────
# Required: NextAuth
# ─────────────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-32-char-string"

# ─────────────────────────────────────────────────────────────────────────────
# Optional: GitHub + Google OAuth (credentials auth works without these)
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Optional: AI (Cloudflare Workers AI; app falls back to heuristic analyzer)
#
# WORKERS_AI_CREDENTIALS = comma-separated rotating pool of accountId::token
# pairs. We round-robin and cool individual credentials on 429/5xx so a single
# account's daily quota doesn't dead-end the demo. Create a Workers AI API
# token per Cloudflare account → paste as accountId::token here.
# The legacy singular WORKERS_AI_CREDENTIAL still works (1-entry pool).
# Get account ID + token: Cloudflare dashboard → Workers AI → Use REST API.
# ─────────────────────────────────────────────────────────────────────────────
WORKERS_AI_CREDENTIALS=""
# WORKERS_AI_CREDENTIAL=""   # legacy singular — optional
WORKERS_AI_MODEL="@cf/meta/llama-3.1-8b-instruct"

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Notifications (Phase 2)
#   - RESEND_API_KEY enables email notifications (https://resend.com)
#   - RESEND_FROM is the verified sender, e.g. "ServiceLens <alerts@yourdomain>"
#   - SLACK_WEBHOOK_URL is NOT read yet — Slack is configured per architecture
#     in the UI (Alerts → Notification routing).
# Without RESEND_API_KEY you get in-app notifications (+ console log) only.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM="ServiceLens <alerts@example.com>"
SLACK_WEBHOOK_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# Optional: GitHub App — opens draft fix PRs and reads private repos it's installed on.
# Permissions: Contents read/write, Pull requests read/write. See docs/secrets.md.
# GITHUB_APP_INSTALLATION_ID is not needed (looked up per repository).
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_INSTALLATION_ID=""

# ─────────────────────────────────────────────────────────────────────────────
# NOT READ YET — reserved for a future Redis queue / realtime bus.
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring scheduler (runs probes → alert rules → incidents)
# By default `next dev` / `next start` run it in-process every SCHEDULER_INTERVAL
# seconds. Set SCHEDULER="off" when you run `npm run worker` separately.
# On Vercel it can't run in-process: drive GET /api/cron/tick from a cron
# (see .github/workflows/scheduler-tick.yml). CRON_SECRET guards that route.
# ─────────────────────────────────────────────────────────────────────────────
SCHEDULER=""
SCHEDULER_INTERVAL="15"
CRON_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Optional: GitHub token for repo analysis
# Without it, public repos work (2 GitHub API calls per service, 60/hour limit).
# Set a fine-grained token with read-only "Contents" access to analyze private
# repos and raise the limit to 5,000/hour.
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# Network safety (SSRF guard)
# Probes, deployed URLs and on-call sheet URLs are user-supplied, so by default
# ServiceLens refuses private/loopback/link-local destinations (incl. cloud
# metadata at 169.254.169.254). Self-hosting and want to monitor internal
# services? Set ALLOW_PRIVATE_PROBES="1" (also allows http:// on-call sheets).
# ─────────────────────────────────────────────────────────────────────────────
ALLOW_PRIVATE_PROBES=""

# Encrypts credentials ServiceLens stores (Postgres/Redis probe connection
# strings, probe headers, Slack webhooks). 32 bytes: `openssl rand -hex 32`.
# Falls back to a key derived from NEXTAUTH_SECRET when unset — set a dedicated
# key in production and never change it afterwards.
SECRETS_ENCRYPTION_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo credentials (seeded user)
#   email: demo@servicelens.com
#   password: demo123
